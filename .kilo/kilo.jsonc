{
  "$schema": "https://kilo.ai",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout -f*": "deny",
      "git clean*": "deny",
      "rm *": "deny",
      "Remove-Item *": "deny"
    }
  }
}